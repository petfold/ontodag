        <mxCell id="ivLJ8DqJXe8OhsBt6OwF-43" value="&lt;h1 style=&quot;margin-top: 0px; margin-bottom: 12px;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Query: B,C&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Should return: &lt;b style=&quot;&quot;&gt;E&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="ivLJ8DqJXe8OhsBt6OwF-29" vertex="1">
          <mxGeometry x="330" y="410" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pvmnl65ZvTDP4r8ZZ6yL-10" value="Algo" parent="0" />
        <mxCell id="pvmnl65ZvTDP4r8ZZ6yL-13" value="&lt;div&gt;&lt;span style=&quot;font-size: 18px; background-color: initial;&quot;&gt;for each defining item take its upset and do set union on these, including intermediate nodes giving elements set&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;for each member of elements set, find those items of their downsets that are subsets of the elements set. Take intersection of all these.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;find the bottom set (excluding those that are subsets of others) e.g. exclude A, AB, BC if ABC is there)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;link new item from members of bottom set&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="pvmnl65ZvTDP4r8ZZ6yL-10">
          <mxGeometry x="40" y="414" width="430" height="230" as="geometry" />
        </mxCell>
