\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces A miniature car-market OntoDAG (taken from the reference implementation's demo). Listings were inserted with $\texttt  {put}(\text  {ad\#1}, \{\text  {Car},\text  {Germany},\text  {Electric}\})$ and $\texttt  {put}(\text  {ad\#2}, \{\text  {Motorcycle},\text  {Germany},\text  {Diesel}\})$. The query $\texttt  {get}(\{\text  {Car},\text  {Electric}\})$ (highlighted categories) intersects the two descendant cones and returns ad~\#1 (highlighted item) --- no ``electric cars'' category was ever created.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:putget}{{2}{3}{A miniature car-market OntoDAG (taken from the reference implementation's demo). Listings were inserted with $\texttt {put}(\text {ad\#1}, \{\text {Car},\text {Germany},\text {Electric}\})$ and $\texttt {put}(\text {ad\#2}, \{\text {Motorcycle},\text {Germany},\text {Diesel}\})$. The query $\texttt {get}(\{\text {Car},\text {Electric}\})$ (highlighted categories) intersects the two descendant cones and returns ad~\#1 (highlighted item) --- no ``electric cars'' category was ever created}{figure.2}{}}
