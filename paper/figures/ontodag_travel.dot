digraph ontodag {
  rankdir=BT;
  node [shape=box, fontname="Helvetica"];
  "*" [shape=ellipse, peripheries=2];
  "Booked" [shape=box, peripheries=2];
  "Flight" [shape=box, peripheries=2];
  "Hotel" [shape=box, peripheries=2];
  "Japan" [shape=box, peripheries=2];
  "Refundable" [shape=box, peripheries=2];
  "inbound.pdf" [shape=box, peripheries=1];
  "kyoto-inn.pdf" [shape=box, peripheries=1];
  "outbound.pdf" [shape=box, peripheries=1];
  "paris-hop.pdf" [shape=box, peripheries=1];
  "rail-pass.pdf" [shape=box, peripheries=1];
  "visa-note.md" [shape=box, peripheries=1];
  "Booked" -> "*";
  "Flight" -> "*";
  "Hotel" -> "*";
  "Japan" -> "*";
  "Refundable" -> "*";
  "inbound.pdf" -> "Booked";
  "kyoto-inn.pdf" -> "Booked";
  "outbound.pdf" -> "Booked";
  "paris-hop.pdf" -> "Booked";
  "rail-pass.pdf" -> "Booked";
  "inbound.pdf" -> "Flight";
  "outbound.pdf" -> "Flight";
  "paris-hop.pdf" -> "Flight";
  "kyoto-inn.pdf" -> "Hotel";
  "inbound.pdf" -> "Japan";
  "kyoto-inn.pdf" -> "Japan";
  "outbound.pdf" -> "Japan";
  "rail-pass.pdf" -> "Japan";
  "visa-note.md" -> "Japan";
  "kyoto-inn.pdf" -> "Refundable";
  "outbound.pdf" -> "Refundable";
  "rail-pass.pdf" -> "Refundable";
}
